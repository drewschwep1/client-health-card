# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# Google service-account key — NEVER commit
*service-account*.json
gmail-service-account.json

# fathom-sync artifacts (transcripts, extractions, poll state)
/data

# Client-confidential manifest — DO NOT commit while repo is PUBLIC.
# Contains transcript quotes, sentiment, wins/concerns, Profound data.
# Make repo private (or move hosting) before removing this line.
/public/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
