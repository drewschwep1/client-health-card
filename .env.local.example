# Fathom API key — user-level, generated at https://fathom.ai user settings
FATHOM_API_KEY=

# Anthropic API key for transcript extraction
ANTHROPIC_API_KEY=

# Shared secret for /api/cron/fathom-sync — send as `x-cron-secret` header
CRON_SECRET=

# Profound API key — X-API-Key header on api.tryprofound.com
PROFOUND_API_KEY=

# Harvest — Personal Access Token + Account ID from id.getharvest.com/developers
# Per-client project IDs are kept in CLIENT_HARVEST_PROJECT in src/lib/constants.ts
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
